{
  "name": "switchboard",
  "displayName": "Switchboard",
  "description": "Claude Code sessions, usage, timeline and controls in one panel. Based on Agent Flow.",
  "version": "0.18.0",
  "publisher": "kennykennethkkang",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "llm",
    "agent",
    "claude",
    "codex",
    "ai",
    "visualization",
    "orchestration"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:agentVisualizer",
    "onView:switchboard.view"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentVisualizer.open",
        "title": "Switchboard: Open"
      },
      {
        "command": "agentVisualizer.openToSide",
        "title": "Switchboard: Open to the Side"
      },
      {
        "command": "agentVisualizer.connectToAgent",
        "title": "Switchboard: Connect to Running Agent"
      },
      {
        "command": "agentVisualizer.configureHooks",
        "title": "Switchboard: Configure Claude Code Hooks"
      },
      {
        "command": "agentVisualizer.openInEditor",
        "title": "Open Switchboard in editor",
        "icon": "$(link-external)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "switchboard",
          "title": "Switchboard",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "switchboard": [
        {
          "type": "webview",
          "id": "switchboard.view",
          "name": "Switchboard",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentVisualizer.open",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "configuration": {
      "title": "Switchboard",
      "properties": {
        "agentVisualizer.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "codex"
          ],
          "enumDescriptions": [
            "Watch both Claude Code and Codex sessions concurrently (default)",
            "Watch only Claude Code sessions",
            "Watch only Codex sessions"
          ],
          "default": "auto",
          "description": "Which agent runtime(s) to watch. In auto mode, runtimes you don't use are harmless no-ops (no session directory = nothing to scan)."
        },
        "agentVisualizer.devServerPort": {
          "type": "number",
          "default": 0,
          "description": "Port for the development server. Set to 0 (default) for production mode, or 3002 for development."
        },
        "agentVisualizer.eventLogPath": {
          "type": "string",
          "default": "",
          "description": "Path to JSONL event log file to watch for agent events"
        },
        "agentVisualizer.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the visualizer when an agent session starts"
        },
        "switchboard.colorTitleBar": {
          "type": "boolean",
          "default": true,
          "description": "Tint this window's title bar in its Switchboard color. Written to the workspace's .vscode/settings.json; title bar colors you set yourself are left alone."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "agentVisualizer.openInEditor",
          "when": "view == switchboard.view",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "agentVisualizer.openInEditor",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node ../app/build.js && pnpm run build:all",
    "build": "node esbuild.js",
    "build:webview": "cd ../web && pnpm run build:webview",
    "build:all": "pnpm run build:webview && pnpm run build",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "lint": "tsc --noEmit",
    "lint:test": "tsc --noEmit --project tsconfig.test.json",
    "test": "tsx --test test/**/*.test.ts",
    "vscode:uninstall": "node scripts/uninstall.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  }
}
